# Docker Compose scenario settings
SCENARIO=benign
RUN_ID=local-demo
PUBLISH_INTERVAL=1.0
MAX_MESSAGES=0

# DNP3 gateway settings. These point to the simulated outstation service.
DNP3_HOST=dnp3-outstation
DNP3_PORT=20000
DNP3_MASTER_ADDRESS=2
DNP3_OUTSTATION_ADDRESS=1
DNP3_POLL_INTERVAL=2.0

# IDS thresholds. Tune only after benign lab measurements are collected.
RATE_LIMIT_MESSAGES=10
RATE_WINDOW_SECONDS=2.0
